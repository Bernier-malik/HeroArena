<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Spacing & Padding -->
  <Thickness x:Key="PagePadding">20</Thickness>
  <Thickness x:Key="SmallSpacing">8</Thickness>
  <Thickness x:Key="MediumSpacing">12</Thickness>
  <Thickness x:Key="LargeSpacing">16</Thickness>
  <x:Double x:Key="SectionSpacing">12</x:Double>

  <!-- Colors - Pokemon Battle Theme -->
  <Color x:Key="PrimaryColor">#FF3E66</Color>
  <Color x:Key="SecondaryColor">#0066FF</Color>
  <Color x:Key="PlayerBgColor">#3E80F0</Color>
  <Color x:Key="EnemyBgColor">#FF3E3E</Color>
  <Color x:Key="SuccessColor">#00CC44</Color>
  <Color x:Key="WarningColor">#FF9900</Color>
  <Color x:Key="DarkBg">#1A1A2E</Color>
  <Color x:Key="CardBg">#000000</Color>
  <Color x:Key="TextPrimary">#000000</Color>
  <Color x:Key="TextSecondary">#000000</Color>
  <Color x:Key="BorderColor">#CCCCCC</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="PlayerBrush">#3E80F0</SolidColorBrush>
  <SolidColorBrush x:Key="EnemyBrush">#FF3E3E</SolidColorBrush>
  <SolidColorBrush x:Key="SuccessBrush">#00CC44</SolidColorBrush>
  <SolidColorBrush x:Key="BackgroundBrush">#F5F5F5</SolidColorBrush>
  <SolidColorBrush x:Key="CardBrush">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="BorderBrush">#DDDDD</SolidColorBrush>

  <!-- Font Sizes -->
  <x:Double x:Key="TitleFontSize">28</x:Double>
  <x:Double x:Key="HeadlineFontSize">20</x:Double>
  <x:Double x:Key="SubheadFontSize">16</x:Double>
  <x:Double x:Key="BodyFontSize">14</x:Double>
  <x:Double x:Key="SmallFontSize">12</x:Double>

  <!-- Button Styles -->
  <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
  <Thickness x:Key="ButtonPadding">12,8</Thickness>
</ResourceDictionary>
